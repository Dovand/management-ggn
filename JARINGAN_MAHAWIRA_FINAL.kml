<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>JARINGAN FIBER OPTIK NOC MAHAWIRA</name>
    <open>1</open>
    <description><![CDATA[Peta Jaringan FTTH NOC Mahawira: Semua ODP Lapangan Muncul Lengkap (281 ODP), Pin Pelanggan Kuning, Modal Popup Bersih Terang (Tanpa Background Gelap), 0 Garis Tambahan, 0 Pin Dobel.]]></description>

    <!-- STYLES -->
    <!-- ODC: Triangle Kuning, Font Label Putih -->
    <Style id="style-odc">
      <IconStyle>
        <color>ff00ffff</color>
        <scale>1.3</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/shapes/triangle.png</href>
        </Icon>
        <hotSpot x="16" y="16" xunits="pixels" yunits="pixels"/>
      </IconStyle>
      <LabelStyle>
        <color>ffffffff</color>
        <scale>0.85</scale>
      </LabelStyle>
      <BalloonStyle>
        <text><![CDATA[
          <div style="font-family:'Segoe UI',Arial,sans-serif; min-width:280px; padding:10px; background:#ffffff; color:#1e293b; border-radius:8px;">
            $[description]
          </div>
        ]]></text>
      </BalloonStyle>
    </Style>

    <!-- ODP: Triangle Merah, Font Label Putih -->
    <Style id="style-odp">
      <IconStyle>
        <color>ff0000ff</color>
        <scale>1.1</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/shapes/triangle.png</href>
        </Icon>
        <hotSpot x="16" y="16" xunits="pixels" yunits="pixels"/>
      </IconStyle>
      <LabelStyle>
        <color>ffffffff</color>
        <scale>0.8</scale>
      </LabelStyle>
      <BalloonStyle>
        <text><![CDATA[
          <div style="font-family:'Segoe UI',Arial,sans-serif; min-width:280px; padding:10px; background:#ffffff; color:#1e293b; border-radius:8px;">
            $[description]
          </div>
        ]]></text>
      </BalloonStyle>
    </Style>

    <!-- PELANGGAN: Pin Kuning Asli Google Earth (ylw-pushpin), Font Putih -->
    <Style id="style-pelanggan">
      <IconStyle>
        <color>ffffffff</color>
        <scale>0.9</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/pushpin/ylw-pushpin.png</href>
        </Icon>
        <hotSpot x="20" y="2" xunits="pixels" yunits="pixels"/>
      </IconStyle>
      <LabelStyle>
        <color>ffffffff</color>
        <scale>0.75</scale>
      </LabelStyle>
      <BalloonStyle>
        <text><![CDATA[
          <div style="font-family:'Segoe UI',Arial,sans-serif; min-width:290px; padding:10px; background:#ffffff; color:#1e293b; border-radius:8px;">
            $[description]
          </div>
        ]]></text>
      </BalloonStyle>
    </Style>

    <!-- LINE FEEDER: BIRU (Hex aabbggrr: ffff0000) -->
    <Style id="style-feeder">
      <LineStyle>
        <color>ffff0000</color>
        <width>4.5</width>
      </LineStyle>
      <LabelStyle><scale>0</scale></LabelStyle>
    </Style>

    <!-- LINE DISTRIBUSI: MERAH (Hex aabbggrr: ff0000ff) -->
    <Style id="style-distribusi">
      <LineStyle>
        <color>ff0000ff</color>
        <width>3.5</width>
      </LineStyle>
      <LabelStyle><scale>0</scale></LabelStyle>
    </Style>

    <!-- LINE DROPCORE: KUNING (Hex aabbggrr: ff00ffff) -->
    <Style id="style-dropcore">
      <LineStyle>
        <color>ff00ffff</color>
        <width>2.0</width>
      </LineStyle>
      <LabelStyle><scale>0</scale></LabelStyle>
    </Style>
